{
  "name": "react-burger",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://vadya02.github.io/react-burger",
  "dependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@ya.praktikum/react-developer-burger-ui-components": "^1.14.2",
    "react": "^19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.6.1",
    "react-scripts": "5.0.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "set PORT=3005 && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:simple": "cypress run --spec \"cypress/e2e/constructor-simple.cy.ts\"",
    "cypress:run:order": "cypress run --spec \"cypress/e2e/order-creation-simple.cy.ts\"",
    "cypress:run:full": "cypress run --spec \"cypress/e2e/full-user-journey.cy.ts\"",
    "cypress:run:custom": "cypress run --spec \"cypress/e2e/custom-commands-test.cy.ts\"",
    "predeploy": "npm run build",
    "deploy":   "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cypress": "^14.5.1",
    "gh-pages": "^6.3.0",
    "jest": "^27.5.1"
  }
